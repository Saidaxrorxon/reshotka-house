# Copy this file to .env on the server and fill in real values.
# Never commit the real .env file.

# Generate a fresh one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-freshly-generated-secret-key

DEBUG=False

# Comma-separated list of hostnames this site is served from
ALLOWED_HOSTS=reshetkihouse.uz,www.reshetkihouse.uz
